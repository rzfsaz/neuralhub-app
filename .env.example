# ══════════════════════════════════════════════════════════════════════════════
# NeuralHub · Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://neuralhub:neuralhub_dev@localhost:5432/neuralhub?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev@localhost:6379

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your_64_char_hex_key_here

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── AI Providers (optional — users supply their own keys via the UI) ──────────
# These are used only for server-side health checks, not for user requests.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=AIzaSy...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@neuralhub.dev

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...
# BETTERSTACK_TOKEN=...
